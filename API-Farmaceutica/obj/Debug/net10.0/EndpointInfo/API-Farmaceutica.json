{
  "openapi": "3.1.1",
  "info": {
    "title": "API-Farmaceutica | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7296"
    },
    {
      "url": "http://localhost:5104"
    }
  ],
  "paths": {
    "/api/Factura/obtener_facturas": {
      "get": {
        "tags": [
          "Factura"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Factura/obtener_facturas_filtradas": {
      "get": {
        "tags": [
          "Factura"
        ],
        "parameters": [
          {
            "name": "FacturaID",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "FechaInicio",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "FechaFin",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "EmpleadoID",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "SucursalID",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "MetodoPagoID",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Factura"
    }
  ]
}